  includedHours       Float?
  estimatedDistanceKm Float?
  estimatedDriveHours Float?
  region              String?
  operationalType     String?
  routeCategory       String?
  longDistance        Boolean                      @default(false)
  desertRoad          Boolean                      @default(false)
  mountainRoad        Boolean                      @default(false)
  seasonalHeatRisk    Boolean                      @default(false)
  guideRequired       Boolean                      @default(false)
  overnight           Boolean                      @default(false)
  sicPossible         Boolean                      @default(false)
  departureCapable    Boolean                      @default(false)
  capacityBased       Boolean                      @default(false)
