// Route Standards — canonical, single source of truth for route distance,
// duration, operational buffers, and risk flags. Keyed by routeCode (the
// existing touringRoute.code or transfer-route operational code). Does
// NOT replace the Route or TouringRoute models — those keep their
// operational pricing/relationship metadata. RouteStandard provides the
// numbers and risk profile that exports / quote engine / dispatch engine
// / voucher layer should read from instead of any per-row freeform value.
// Phase 1: model + admin + import/export. Phase 2 will wire engines to it.
model RouteStandard {
  id                        String   @id @default(uuid()) @db.Uuid
  routeCode                 String   @unique
  routeName                 String
  fromCity                  String?
  toCity                    String?
  // toCity may be null when destinationArea describes a region rather
  // than a single city (e.g., "Dead Sea Resorts", "Wadi Rum Camps").
  destinationArea           String?
  standardDistanceKm        Float?
  standardDurationHours     Float?
  // Buffer minutes added to operational scheduling for prep/loading/etc.
  // Dispatch engine reads this when checking turnaround between back-to-
  // back operations on the same vehicle/driver.
  operationalBufferMinutes  Int?
  longDistanceFlag          Boolean  @default(false)
  overnightRisk             Boolean  @default(false)
  mountainRoadFlag          Boolean  @default(false)
  borderCrossingFlag        Boolean  @default(false)
  airportRouteFlag          Boolean  @default(false)
  notes                     String?
  isActive                  Boolean  @default(true)
  // Provenance — distinguishes operator-created standards from auto-
  // bootstrapped ones so the admin UI can show a "draft from existing
  // route" tag and ops know which rows still need a review pass. Values:
  // 'AUTO_BOOTSTRAP' | 'IMPORTED' | 'MANUAL' (or null for legacy rows).
  source                    String?
  // Canonical operational route code (FROM_TO short form — AMM_PET,
  // PET_WR, WR_AQJ etc.). The original routeCode column is preserved
  // for legacy lookups (quote items, vouchers, dispatch references
  // captured by the old code keep resolving), but the operational
  // truth layer moves to canonicalRouteCode. Null until the
  // canonicalization step assigns one. Not unique — multiple legacy
  // codes may map to the same canonical code during the cleanup
  // (mergeDuplicates resolves them into one VERIFIED standard).
  canonicalRouteCode        String?
  // Review workflow status. AUTO_BOOTSTRAP = freshly bootstrapped, not
  // yet reviewed. REVIEW_REQUIRED = sanity check flagged the row
  // (suspicious duration, missing data, messy code). VERIFIED = ops
  // signed off on the numbers. CANONICALIZED = canonicalRouteCode is
  // assigned AND the row is the "winning" standard for that code.
  reviewStatus              String?
  // Set by detectSuspiciousDuration during bootstrap or recompute.
  // True when the inherited duration looks like an excursion day
  // length rather than realistic transfer time (e.g. Dead Sea->Petra
  // 11 h, Wadi Rum->Aqaba 8 h). Drives the refinement dashboard
  // "needs attention" counter.
  suspiciousDurationFlag    Boolean  @default(false)
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt
  // Touring Route Legs v1 — back-relation to legs that reference this
  // standard. ON DELETE SET NULL (configured in migration) so removing
  // a standard doesn't cascade-delete every touring-route leg using it;
  // legs lose the link but their fromArea/toArea + sequence stay intact.
  routeLegs                 TouringRouteLeg[]

  @@index([isActive, routeCode])
  @@index([fromCity, toCity])
  @@index([source])
  @@index([canonicalRouteCode])
  @@index([reviewStatus])
  @@map("route_standards")
}

// Operational Areas Catalog v1 — canonical movement endpoints used by the
// Route Builder + Canonical Builder + Touring Routes + Dispatch + Transfers
// + Excursion composition. Codes (AMM, QAIA, PET, …) drive the FROM_TO
// canonical route-code generator. Replaces the hardcoded dictionary that
// previously lived in apps/api/src/route-standards/operational-areas.ts.
model OperationalArea {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique
  name        String
  // CITY | AIRPORT | BORDER | HOTEL_ZONE | TOURISM_SITE | CAMP_AREA | PORT | RESORT_AREA
  type        String
  city        String
  region      String?
  country     String   @default("Jordan")
  isActive    Boolean  @default(true)
  // Default risk flags suggested when this area is on either side of a
  // route. mergeDefaultFlags ORs the flags from both endpoints in the
  // Route Builder so airport legs auto-suggest airportRouteFlag, border
  // legs auto-suggest borderCrossingFlag, etc. Operator can always
  // override per row.
  airportRouteFlagDefault    Boolean @default(false)
  borderCrossingFlagDefault  Boolean @default(false)
  mountainRoadFlagDefault    Boolean @default(false)
  overnightRiskDefault       Boolean @default(false)
  // Preferred Operational Area Logic (v2C addendum) — operationally
  // primary areas get a low priority value so they win when multiple
  // areas share a city + type. Example: QAIA=1, Marka=2 within
  // AIRPORT for Amman. NULL = lowest priority (falls back to
  // PREFERRED_TYPE_ORDER and alphabetical sort).
  priority                  Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  // Touring Route Legs v1 — back-relations so we can include the area's
  // outgoing and incoming legs when needed. Named relations so Prisma
  // can disambiguate FROM vs TO.
  legsAsFrom  TouringRouteLeg[] @relation("LegFromArea")
  legsAsTo    TouringRouteLeg[] @relation("LegToArea")

  @@index([isActive, code])
  @@index([city])
  @@index([type])
  @@map("operational_areas")
}

// Touring Route Legs v1 — ordered Route Standard movements that compose
// the operational flow of a Touring Route. Pricing is NOT derived from
// these legs (TouringRoutePricing remains the pricing authority); legs
// only describe movement + timing + risk profile used by quote display
// (e.g. "Amman → Madaba → Nebo → Petra") and dispatch feasibility
// (drive duration + buffer + estimated stop time).
model TouringRouteLeg {
  id                    String          @id @default(uuid()) @db.Uuid
  touringRouteId        String          @db.Uuid
  touringRoute          TouringRoute    @relation(fields: [touringRouteId], references: [id], onDelete: Cascade)
  // Ordered position within the touring route. Unique per touring route
  // — reordering reassigns sequences. Gaps are allowed (a deleted leg
  // leaves a gap until the next reorder).
  sequence              Int
  // Optional. NULL when no RouteStandard exists yet for the from/to
  // pair OR when legType is STOP / WAIT / ACTIVITY_ANCHOR (those legs
  // don't model movement). Auto-resolved from fromAreaId + toAreaId
  // when a matching canonical route code exists.
  routeStandardId       String?         @db.Uuid
  routeStandard         RouteStandard?  @relation(fields: [routeStandardId], references: [id])
  fromAreaId            String?         @db.Uuid
  fromArea              OperationalArea? @relation("LegFromArea", fields: [fromAreaId], references: [id])
  toAreaId              String?         @db.Uuid
  toArea                OperationalArea? @relation("LegToArea", fields: [toAreaId], references: [id])
  // DRIVE | STOP | WAIT | ACTIVITY_ANCHOR. DRIVE = a movement leg with
  // a routeStandard; STOP = scheduled stop (photo / break); WAIT =
  // operational hold (border, transit); ACTIVITY_ANCHOR = the leg
  // exists to mark where a planned activity happens during the day.
  legType               String          @default("DRIVE")
  notes                 String?
  // Stop time at the FROM end of this leg (e.g. 30 min photo stop at
  // Mount Nebo before driving on to Petra). Counted toward total
  // operational duration but NOT toward drive duration.
  estimatedStopMinutes  Int?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  @@unique([touringRouteId, sequence])
  @@index([touringRouteId, sequence])
  @@index([routeStandardId])
  @@map("touring_route_legs")
}

