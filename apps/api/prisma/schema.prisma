  guide     Guide    @relation(fields: [guideId], references: [id], onDelete: Cascade)

  @@index([guideId, startDate, endDate])
  @@map("guide_blocked_dates")
}

// Append-only operational event stream. Drives the replay log on
// /operations/simulation and feeds the live activity feeds on the dispatch
// dashboard. Cheap to write (single insert), never updated, never deleted
// outside booking cascade.
model DispatchEvent {
  id               String                 @id @default(uuid()) @db.Uuid
  bookingId        String                 @db.Uuid
  bookingServiceId String?                @db.Uuid
  eventType        DispatchEventType
  severity         DispatchEventSeverity?
  occurredAt       DateTime               @default(now())
  actor            String?
  payload          Json?
  notes            String?
  createdAt        DateTime               @default(now())
  booking          Booking                @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  bookingService   BookingService?        @relation(fields: [bookingServiceId], references: [id], onDelete: SetNull)

  @@index([bookingId, occurredAt])
  @@index([bookingServiceId, occurredAt])
  @@index([eventType])
  @@index([occurredAt])
  @@map("dispatch_events")
}

model Restaurant {
  id                String           @id @default(uuid()) @db.Uuid
  name              String
  city              String?
  region            String?
  cuisineType       String?
  capacity          Int?
  email             String?
  phone             String?
  mealTypes         String[]         @default([])
  active            Boolean          @default(true)
  indoor            Boolean          @default(true)
  outdoor           Boolean          @default(false)
  halalSupport      Boolean          @default(false)
  vegetarianSupport Boolean          @default(false)
  veganSupport      Boolean          @default(false)
  notes             String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  bookingServices   BookingService[]

  @@index([active, name])
  @@index([city, region])
  @@map("restaurants")
}

model BookingAuditLog {
  id               String                 @id @default(uuid()) @db.Uuid
  bookingId        String                 @db.Uuid
  bookingServiceId String?                @db.Uuid
  entityType       BookingAuditEntityType
  entityId         String                 @db.Uuid
  oldValue         String?
  newValue         String?
  action           String
  note             String?
  actorUserId      String?                @db.Uuid
  actor            String?
  createdAt        DateTime               @default(now())
  booking          Booking                @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  bookingService   BookingService?        @relation(fields: [bookingServiceId], references: [id], onDelete: Cascade)

  @@index([bookingId, createdAt])
  @@index([bookingServiceId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([entityType, entityId, createdAt])
  @@map("booking_audit_logs")
}

model Voucher {
  id               String         @id @default(uuid()) @db.Uuid
  bookingId        String         @db.Uuid
  bookingServiceId String         @unique @db.Uuid
  type             VoucherType
  supplierId       String?        @db.Uuid
  status           VoucherStatus  @default(DRAFT)
  issuedAt         DateTime?
  generatedAt      DateTime?
  generatedBy      String?        @db.Uuid
  sentAt           DateTime?
  snapshotJson     Json?
  notes            String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  booking          Booking        @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  bookingService   BookingService @relation(fields: [bookingServiceId], references: [id], onDelete: Cascade)
  supplier         Supplier?      @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@index([bookingId, status])
  @@index([supplierId])
  @@index([generatedAt])
  @@map("vouchers")
}

