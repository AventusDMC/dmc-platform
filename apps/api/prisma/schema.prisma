  touringRoute               TouringRoute?                 @relation(fields: [touringRouteId], references: [id], onDelete: SetNull)
  touringRoutePricing        TouringRoutePricing?          @relation(fields: [touringRoutePricingId], references: [id], onDelete: SetNull)
