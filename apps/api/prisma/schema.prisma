model HotelContractSupplement {
  id              String                            @id @default(uuid()) @db.Uuid
  hotelContractId String                            @db.Uuid
  roomCategoryId  String?                           @db.Uuid
  type            HotelContractSupplementType
  // Optional meal-plan tag. When set, the quote engine treats this
  // supplement as the canonical add-on that converts a base BB rate
  // into the requested meal plan: mealPlanCode=HB → applied when the
  // booking selects HB, mealPlanCode=FB → applied for FB, etc.
  // null = legacy semantics — the resolver falls back to inferring from
  // the `type` enum (EXTRA_DINNER counts as HB for backwards-compat).
  // Lets contracts cleanly carry both "HB = 18 JOD pp/n" and
  // "FB = 36 JOD pp/n" without the resolver double-counting.
  mealPlanCode    HotelMealPlan?
  chargeBasis     HotelContractChargeBasis
  amount          Float
  currency        String
  // Optional date window the supplement is charged on. When set, the
  // quote engine only applies it on nights the stay covers within
  // [appliesFrom, appliesTo] — e.g. a Gala Dinner pinned to 31 Dec
  // (appliesFrom = appliesTo = that date) is billed once per person and
  // only when the stay includes that night. Both null = legacy
  // behaviour (charged across the whole stay per the charge basis).
  appliesFrom     DateTime?
  appliesTo       DateTime?
  isMandatory     Boolean                           @default(false)
  isActive        Boolean                           @default(true)
  notes           String?
  createdAt       DateTime                          @default(now())
  updatedAt       DateTime                          @updatedAt
  auditLogs       HotelContractSupplementAuditLog[]
  hotelContract   HotelContract                     @relation(fields: [hotelContractId], references: [id], onDelete: Cascade)
  roomCategory    HotelRoomCategory?                @relation(fields: [roomCategoryId], references: [id], onDelete: SetNull)

  @@index([hotelContractId, type, isActive])
  @@index([hotelContractId, roomCategoryId])
  @@index([hotelContractId, roomCategoryId, type, isActive])
  @@index([roomCategoryId, type])
  @@index([hotelContractId, mealPlanCode, isActive])
  @@map("hotel_contract_supplements")
}

