// Drivers are the transport-side analogue of the Guide model. Used to
// formalise the per-service driver assignment that previously lived only as
// a free-text `assignedTo` string on BookingService.
model Driver {
  id              String           @id @default(uuid()) @db.Uuid
  fullName        String
  phone           String?
  licenseNumber   String?           @map("license_number")
  languages       String[]          @default([])
  active          Boolean           @default(true)
  // Optional link to the transport supplier this driver belongs to. Lets
  // the operations grid filter drivers to the supplier already assigned to
  // the service. SetNull on supplier delete so we don't cascade away
  // driver records.
  supplierId      String?           @db.Uuid
  notes           String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  bookingServices BookingService[]

  @@index([active, fullName])
  @@index([supplierId])
  @@map("drivers")
}

