generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Booking {
  id                    String                @id @default(uuid()) @db.Uuid
  quoteId               String                @db.Uuid
  acceptedVersionId     String                @db.Uuid
  clientCompanyId       String?               @db.Uuid
  amendmentNumber       Int                   @default(1)
  amendedFromId         String?               @db.Uuid
  bookingType           BookingType           @default(FIT)
  status                BookingStatus         @default(draft)
  clientInvoiceStatus   ClientInvoiceStatus   @default(unbilled)
  supplierPaymentStatus SupplierPaymentStatus @default(unpaid)
  statusNote            String?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  bookingRef            String
  snapshotJson          Json
  clientSnapshotJson    Json
  brandSnapshotJson     Json?
  contactSnapshotJson   Json
  itinerarySnapshotJson Json
  pricingSnapshotJson   Json
  adults                Int
  children              Int
  pax                   Int                   @default(0)
  roomCount             Int
  nightCount            Int
  startDate             DateTime?
  endDate               DateTime?
  accessToken           String                @unique
  acceptedVersion       QuoteVersion          @relation("BookingAcceptedVersion", fields: [acceptedVersionId], references: [id])
  quote                 Quote                 @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  amendedFrom           Booking?              @relation("BookingAmendments", fields: [amendedFromId], references: [id], onDelete: SetNull)
  amendments            Booking[]             @relation("BookingAmendments")
  days                  BookingDay[]
  services              BookingService[]
  vouchers              Voucher[]
  auditLogs             BookingAuditLog[]
  passengers            BookingPassenger[]
  payments              Payment[]
  roomingEntries        BookingRoomingEntry[]
  seriesDeparture       SeriesDeparture?
  dispatchEvents        DispatchEvent[]

  @@index([bookingType])
  @@index([clientCompanyId])
  @@index([amendedFromId])
  @@index([startDate])
  @@index([clientInvoiceStatus])
  @@index([supplierPaymentStatus])
  @@index([status])
  @@map("bookings")
}

model Series {
  id                     String            @id @default(uuid()) @db.Uuid
  seriesCode             String            @unique
  seriesName             String
  active                 Boolean           @default(true)
  recurringSchedule      String?
  destinationCountry     String?
  operationalNotes       String?
  packageTemplateId      String?           @db.Uuid
  programVariantsJson    Json?
  branchExtensionsJson   Json?
  sharedCoreServicesJson Json?
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt
  packageTemplate        PackageTemplate?  @relation(fields: [packageTemplateId], references: [id], onDelete: SetNull)
  departures             SeriesDeparture[]

  @@index([active, seriesName])
  @@index([destinationCountry])
  @@index([packageTemplateId])
  @@map("series")
}

model SeriesDeparture {
  id                    String    @id @default(uuid()) @db.Uuid
  seriesId              String    @db.Uuid
  bookingId             String    @unique @db.Uuid
  departureCode         String?
  departureDate         DateTime?
  paxCount              Int       @default(0)
  lowOccupancyThreshold Int?
  totalCapacity         Int?
  guaranteedMinimumPax  Int?
  sharedCoachCapacity   Int?
  reservedSeats         Int?
  stopSaleThreshold     Int?
  hotelAllotmentsJson   Json?
  sharedInventoryJson   Json?
  splitServicesJson     Json?
  status                String    @default("PLANNED")
  operationalNotes      String?
  templateSnapshotJson  Json?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  series                Series    @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  booking               Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([seriesId, departureDate])
  @@index([departureDate])
  @@index([status])
  @@map("series_departures")
}

model BookingDay {
  id        String           @id @default(uuid()) @db.Uuid
  bookingId String           @db.Uuid
  dayNumber Int
  date      DateTime?
  title     String
  notes     String?
  status    String           @default("PENDING")
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  booking   Booking          @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  services  BookingService[]

  @@unique([bookingId, dayNumber])
  @@index([bookingId, date])
  @@index([status])
  @@map("booking_days")
}

model BookingPassenger {
  id                   String                     @id @default(uuid()) @db.Uuid
  bookingId            String                     @db.Uuid
  fullName             String?
  firstName            String
  lastName             String
  title                String?
  gender               String?
  dateOfBirth          DateTime?
  nationality          String?
  passportNumber       String?
  passportIssueDate    DateTime?
  passportExpiryDate   DateTime?
  arrivalFlight        String?
  departureFlight      String?
  entryPoint           String?
  visaStatus           String?
  emergencyContactName  String?
  emergencyContactPhone String?
  dietaryNotes         String?
  roomingNotes         String?
  hotelCategoryVariant String?
  branchExtension      String?
  isLead               Boolean                    @default(false)
  notes                String?
  createdAt            DateTime                   @default(now())
  updatedAt            DateTime                   @updatedAt
  booking              Booking                    @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  roomingAssignments   BookingRoomingAssignment[]

  @@index([bookingId, isLead])
  @@index([hotelCategoryVariant])
  @@index([branchExtension])
  @@map("booking_passengers")
}

model Payment {
  id        String        @id @default(uuid()) @db.Uuid
  bookingId String        @db.Uuid
  type      PaymentType
  amount    Float
  currency  String
  status    PaymentStatus @default(PENDING)
  method    PaymentMethod
  reference String?
  dueDate   DateTime?
  paidAt    DateTime?
  notes     String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  booking   Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId, type, status])
  @@index([bookingId, dueDate])
  @@index([status])
  @@index([dueDate])
  @@index([createdAt])
  @@map("payments")
}

model BookingRoomingEntry {
  id          String                     @id @default(uuid()) @db.Uuid
  bookingId   String                     @db.Uuid
  roomType    String?
  occupancy   BookingRoomOccupancy       @default(unknown)
  notes       String?
  sortOrder   Int                        @default(0)
  createdAt   DateTime                   @default(now())
  updatedAt   DateTime                   @updatedAt
  booking     Booking                    @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  assignments BookingRoomingAssignment[]

  @@index([bookingId, sortOrder])
  @@map("booking_rooming_entries")
}

model BookingRoomingAssignment {
  id                    String              @id @default(uuid()) @db.Uuid
  bookingRoomingEntryId String              @db.Uuid
  bookingPassengerId    String              @db.Uuid
  createdAt             DateTime            @default(now())
  bookingRoomingEntry   BookingRoomingEntry @relation(fields: [bookingRoomingEntryId], references: [id], onDelete: Cascade)
  bookingPassenger      BookingPassenger    @relation(fields: [bookingPassengerId], references: [id], onDelete: Cascade)

  @@unique([bookingRoomingEntryId, bookingPassengerId])
  @@index([bookingPassengerId])
  @@map("booking_rooming_assignments")
}

model City {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  country   String?
  latitude  Float
  longitude Float
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  hotels    Hotel[]
  places    Place[]

  @@index([isActive, name])
  @@map("cities")
}

model Company {
  id           String           @id @default(uuid()) @db.Uuid
  name         String
  type         String?
  website      String?
  country      String?
  city         String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  logoUrl      String?
  primaryColor String?
  // Agent Portal — commission rate (%) the agent company earns on the sell
  // value of its bookings. NULL = no commission configured. Set by admins on
  // the company record; surfaced read-only in the agent portal.
  agentCommissionPercent Float?
  // Agent Portal — rate mode. GROSS (default): agent sees the published sell
  // price and earns agentCommissionPercent. NET: agent sees a net buy rate
  // (cost + agentNetHandlingPercent) instead of gross, and earns no
  // commission (they add their own margin downstream). Display-layer only —
  // the quote pricing engine is unchanged.
  agentRateMode          String  @default("GROSS")
  agentNetHandlingPercent Float?
  activities   Activity[]
  branding     CompanyBranding?
  contacts     Contact[]
  leads        Lead[]
  brandQuotes  Quote[]          @relation("BrandQuotes")
  clientQuotes Quote[]          @relation("ClientQuotes")
  auditLogs    AuditLog[]
  invitations  Invitation[]
  users        User[]

  @@map("companies")
}

model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  companyId String   @db.Uuid
  userId    String?  @db.Uuid
  action    String
  entity    String
  entityId  String?
  metadata  Json?
  createdAt DateTime @default(now())
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, createdAt])
  @@index([companyId, action, createdAt])
  @@index([entity, entityId])
  @@map("audit_logs")
}

model Invitation {
  id              String    @id @default(uuid()) @db.Uuid
  email           String
  role            String
  companyId       String    @db.Uuid
  token           String    @unique
  expiresAt       DateTime
  acceptedAt      DateTime?
  revokedAt       DateTime?
  invitedByUserId String?   @db.Uuid
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  company         Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, createdAt])
  @@index([companyId, email])
  @@index([token, expiresAt])
  @@map("invitations")
}

model CompanyBranding {
  id             String   @id @default(uuid()) @db.Uuid
  companyId      String   @unique @db.Uuid
  displayName    String?
  logoUrl        String?
  headerTitle    String?
  headerSubtitle String?
  footerText     String?
  website        String?
  email          String?
  phone          String?
  primaryColor   String?
  secondaryColor String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  company        Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("company_branding")
}

model Activity {
  id                  String                       @id @default(uuid()) @db.Uuid
  code                String?                      @unique
  name                String
  description         String?
  category            String?
  city                String?
  region              String?
  supplierCompanyId   String                       @db.Uuid
  supplierId          String?                      @db.Uuid
  pricingBasis        ActivityPricingBasis
  costPrice           Float
  sellPrice           Float
  durationMinutes     Int?
  durationHours       Float?
  difficulty          String?
  guideRequired       Boolean?
  sicPossible         Boolean                      @default(false)
  fitnessLevel        String?
  familyFriendly      Boolean                      @default(false)
  seasonalRisk        String?
  terrainType         String?
  recommendedPaxRange String?
  startPoint          String?
  endPoint            String?
  inclusions          String?
  exclusions          String?
  operationalNotes    String?
  categoryTags        Json?
  reviewNotes         String?
  active              Boolean                      @default(true)
  // Guided Quote Builder v2B — experience taxonomy. All nullable so
  // existing activities stay valid; admin populates incrementally.
  // moodCategory: CULTURE | ADVENTURE | RELIGIOUS | RELAXATION |
  // FAMILY | WELLNESS | FOOD_LOCAL. Drives the per-destination mood
  // grouping in the Guided Journey Composer.
  moodCategory             String?
  // Free-text experience descriptor ("Guided heritage walk", "Bedouin
  // dinner", "Spa half day") — operator-facing label used by the
  // experience cards. Defaults to the existing description when null.
  experienceType           String?
  // RELAXED | MODERATE | INTENSE — drives the operational intensity
  // chip on the card and the per-destination pacing assessment.
  operationalIntensity     String?
  // Religious significance flag — distinct from moodCategory because
  // an activity can be "religious significance: yes" within a Culture
  // mood (e.g. Madaba mosaic map church).
  religiousSignificance    Boolean   @default(false)
  // Premium / Signature experience flag — bumps the activity into the
  // top-of-journey "Top experiences" highlights strip.
  premiumExperienceFlag    Boolean   @default(false)
  createdAt           DateTime                     @default(now())
  updatedAt           DateTime                     @updatedAt
  supplierCompany     Company                      @relation(fields: [supplierCompanyId], references: [id])
  rateVariants        ActivityRateVariant[]
  bookingServices     BookingService[]
  excursionComponents ExcursionTemplateComponent[]
  packageComponents   PackageTemplateComponent[]
  quoteItems          QuoteItem[]

  @@index([active, name])
  @@index([code])
  @@index([city, active])
  @@index([supplierCompanyId])
  // Guided v2B — backs the per-destination + mood lookup.
  @@index([moodCategory, city, active])
  @@map("activities")
}

model ActivityRateVariant {
  id                  String                    @id @default(uuid()) @db.Uuid
  activityId          String                    @db.Uuid
  name                String
  durationMinutes     Int?
  durationHours       Float?
  pricingBasis        ActivityPricingBasis
  supplierCompanyId   String?                   @db.Uuid
  currency            String                    @default("USD")
  costPrice           Float
  sellPrice           Float
  minPax              Int?
  maxPax              Int?
  maxPaxPerUnit       Int?
  capacityPricing     Boolean                   @default(false)
  active              Boolean                   @default(true)
  notes               String?
  difficulty          String?
  guideRequired       Boolean?
  guideRequirement    ActivityGuideRequirement?
  sicPossible         Boolean                   @default(false)
  fitnessLevel        String?
  familyFriendly      Boolean                   @default(false)
  seasonalRisk        String?
  terrainType         String?
  recommendedPaxRange String?
  meetingPoint        String?
  startPoint          String?
  endPoint            String?
  operationalNotes    String?
  suitability         String?
  fitnessNotes        String?
  waterNotes          String?
  seasonalNotes       String?
  inclusions          String?
  exclusions          String?
  sortOrder           Int                       @default(0)
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt
  activity            Activity                  @relation(fields: [activityId], references: [id], onDelete: Cascade)
  quoteItems          QuoteItem[]

  @@index([activityId, active, sortOrder])
  @@index([supplierCompanyId])
  @@map("activity_rate_variants")
}

model Contact {
  id        String   @id @default(uuid()) @db.Uuid
  companyId String   @db.Uuid
  firstName String
  lastName  String
  email     String?
  phone     String?
  title     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  company   Company  @relation(fields: [companyId], references: [id])
  quotes    Quote[]

  @@map("contacts")
}

model GalleryImage {
  id              String           @id @default(uuid()) @db.Uuid
  title           String
  imageUrl        String
  destination     String?
  category        String?
  createdAt       DateTime         @default(now())
  itineraryImages ItineraryImage[]

  @@map("gallery_images")
}

model HotelCategory {
  id           String        @id @default(uuid()) @db.Uuid
  name         String
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  hotels       Hotel[]
  quoteOptions QuoteOption[]

  @@index([isActive, name])
  @@map("hotel_categories")
}

model HotelContract {
  id                          String                              @id @default(uuid()) @db.Uuid
  hotelId                     String                              @db.Uuid
  name                        String
  validFrom                   DateTime
  validTo                     DateTime
  currency                    String
  ratePolicies                Json?
  createdAt                   DateTime                            @default(now())
  updatedAt                   DateTime                            @updatedAt
  allotments                  HotelAllotment[]
  cancellationPolicy          HotelContractCancellationPolicy?
  cancellationPolicyAuditLogs HotelContractCancellationAuditLog[]
  childPolicy                 HotelContractChildPolicy?
  mealPlanAuditLogs           HotelContractMealPlanAuditLog[]
  mealPlans                   HotelContractMealPlan[]
  hotel                       Hotel                               @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  occupancyAuditLogs          HotelContractOccupancyAuditLog[]
  occupancyRules              HotelContractOccupancyRule[]
  promotions                  Promotion[]
  rates                       HotelRate[]
  supplementAuditLogs         HotelContractSupplementAuditLog[]
  supplements                 HotelContractSupplement[]
  childPolicyAuditLogs        HotelContractChildPolicyAuditLog[]
  quoteItems                  QuoteItem[]
  packageComponents           PackageTemplateComponent[]
  // Hotel Contract Stabilization & Trustworthiness v2 — operator-driven
  // confidence rating. IMPORTED_UNVERIFIED is the default state for
  // newly-imported PDFs; operators move contracts up through the rest
  // of the flow as they verify rooms / supplements / seasons.
  confidence                  HotelContractConfidence             @default(IMPORTED_UNVERIFIED)
  lastVerifiedAt              DateTime?
  verifiedBy                  String?
  verificationNotes           String?
  // Group free-of-charge (complimentary) policy carried by the contract,
  // mirroring the Quote FOC fields. Group quotes on this contract inherit
  // these when the quote's own FOC is still unset. focType: none|ratio|fixed.
  focType                     String                              @default("none")
  focRatio                    Float?
  focCount                    Int?
  focRoomType                 String?

  @@index([hotelId])
  @@index([confidence])
  @@map("hotel_contracts")
}

model ContractImport {
  id                String                   @id @default(uuid()) @db.Uuid
  contractType      ContractImportType
  supplierId        String?                  @db.Uuid
  supplierName      String?
  sourceFileName    String
  sourceFilePath    String
  sourceContentType String?
  contractYear      Int?
  validFrom         DateTime?
  validTo           DateTime?
  status            ContractImportStatus     @default(DRAFT)
  extractedJson     Json?
  approvedJson      Json?
  warnings          Json?
  errors            Json?
  importedEntityId  String?                  @db.Uuid
  approvedByUserId  String?                  @db.Uuid
  approvedAt        DateTime?
  importedAt        DateTime?
  createdByUserId   String?                  @db.Uuid
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt
  auditLogs         ContractImportAuditLog[]

  @@index([contractType, status, createdAt])
  @@index([supplierId])
  @@map("contract_imports")
}

model ContractImportAuditLog {
  id               String               @id @default(uuid()) @db.Uuid
  contractImportId String               @db.Uuid
  action           String
  status           ContractImportStatus
  actorUserId      String?              @db.Uuid
  actor            String?
  note             String?
  metadata         Json?
  createdAt        DateTime             @default(now())
  contractImport   ContractImport       @relation(fields: [contractImportId], references: [id], onDelete: Cascade)

  @@index([contractImportId, createdAt])
  @@index([actorUserId, createdAt])
  @@map("contract_import_audit_logs")
}

model HotelContractOccupancyRule {
  id              String                           @id @default(uuid()) @db.Uuid
  hotelContractId String                           @db.Uuid
  roomCategoryId  String?                          @db.Uuid
  occupancyType   HotelOccupancyType
  minAdults       Int
  maxAdults       Int
  maxChildren     Int                              @default(0)
  maxOccupants    Int
  isActive        Boolean                          @default(true)
  notes           String?
  createdAt       DateTime                         @default(now())
  updatedAt       DateTime                         @updatedAt
  auditLogs       HotelContractOccupancyAuditLog[]
  hotelContract   HotelContract                    @relation(fields: [hotelContractId], references: [id], onDelete: Cascade)
  roomCategory    HotelRoomCategory?               @relation(fields: [roomCategoryId], references: [id], onDelete: SetNull)

  @@index([hotelContractId, occupancyType, isActive])
  @@index([hotelContractId, roomCategoryId, occupancyType, isActive])
  @@index([roomCategoryId, occupancyType])
  @@map("hotel_contract_occupancy_rules")
}

model HotelContractOccupancyAuditLog {
  id              String                      @id @default(uuid()) @db.Uuid
  hotelContractId String                      @db.Uuid
  occupancyRuleId String?                     @db.Uuid
  action          String
  oldValue        String?
  newValue        String?
  note            String?
  actorUserId     String                      @db.Uuid
  actor           String?
  createdAt       DateTime                    @default(now())
  hotelContract   HotelContract               @relation(fields: [hotelContractId], references: [id], onDelete: Cascade)
  occupancyRule   HotelContractOccupancyRule? @relation(fields: [occupancyRuleId], references: [id], onDelete: Cascade)

  @@index([hotelContractId, createdAt])
  @@index([occupancyRuleId, createdAt])
  @@index([actorUserId, createdAt])
  @@map("hotel_contract_occupancy_audit_logs")
}

model HotelContractChildPolicy {
  id              String                             @id @default(uuid()) @db.Uuid
  hotelContractId String                             @unique @db.Uuid
  infantMaxAge    Int
  childMaxAge     Int
  notes           String?
  createdAt       DateTime                           @default(now())
  updatedAt       DateTime                           @updatedAt
  auditLogs       HotelContractChildPolicyAuditLog[]
  hotelContract   HotelContract                      @relation(fields: [hotelContractId], references: [id], onDelete: Cascade)
  bands           HotelContractChildPolicyBand[]

  @@map("hotel_contract_child_policies")
}

model HotelContractChildPolicyBand {
  id            String                             @id @default(uuid()) @db.Uuid
  childPolicyId String                             @db.Uuid
  label         String
  minAge        Int
  maxAge        Int
  chargeBasis   ChildPolicyChargeBasis
  chargeValue   Float?
  isActive      Boolean                            @default(true)
  notes         String?
  createdAt     DateTime                           @default(now())
  updatedAt     DateTime                           @updatedAt
  auditLogs     HotelContractChildPolicyAuditLog[]
  childPolicy   HotelContractChildPolicy           @relation(fields: [childPolicyId], references: [id], onDelete: Cascade)

  @@index([childPolicyId, isActive, minAge, maxAge])
  @@map("hotel_contract_child_policy_bands")
}

model HotelContractChildPolicyAuditLog {
  id                String                        @id @default(uuid()) @db.Uuid
  hotelContractId   String                        @db.Uuid
  childPolicyId     String?                       @db.Uuid
  childPolicyBandId String?                       @db.Uuid
  action            String
  oldValue          String?
  newValue          String?
  note              String?
  actorUserId       String                        @db.Uuid
  actor             String?
  createdAt         DateTime                      @default(now())
  hotelContract     HotelContract                 @relation(fields: [hotelContractId], references: [id], onDelete: Cascade)
  childPolicy       HotelContractChildPolicy?     @relation(fields: [childPolicyId], references: [id], onDelete: Cascade)
  childPolicyBand   HotelContractChildPolicyBand? @relation(fields: [childPolicyBandId], references: [id], onDelete: Cascade)

  @@index([hotelContractId, createdAt])
  @@index([childPolicyId, createdAt])
  @@index([childPolicyBandId, createdAt])
  @@index([actorUserId, createdAt])
  @@map("hotel_contract_child_policy_audit_logs")
}

model HotelContractCancellationPolicy {
  id                 String                              @id @default(uuid()) @db.Uuid
  hotelContractId    String                              @unique @db.Uuid
  summary            String?
  notes              String?
  noShowPenaltyType  HotelCancellationPenaltyType?
  noShowPenaltyValue Float?
  createdAt          DateTime                            @default(now())
  updatedAt          DateTime                            @updatedAt
  auditLogs          HotelContractCancellationAuditLog[]
  hotelContract      HotelContract                       @relation(fields: [hotelContractId], references: [id], onDelete: Cascade)
  rules              HotelContractCancellationRule[]

  @@map("hotel_contract_cancellation_policies")
}

model HotelContractCancellationRule {
  id                   String                              @id @default(uuid()) @db.Uuid
  cancellationPolicyId String                              @db.Uuid
  windowFromValue      Int
  windowToValue        Int
  deadlineUnit         HotelCancellationDeadlineUnit
  penaltyType          HotelCancellationPenaltyType
  penaltyValue         Float?
  isActive             Boolean                             @default(true)
  notes                String?
  createdAt            DateTime                            @default(now())
  updatedAt            DateTime                            @updatedAt
  auditLogs            HotelContractCancellationAuditLog[]
  cancellationPolicy   HotelContractCancellationPolicy     @relation(fields: [cancellationPolicyId], references: [id], onDelete: Cascade)

  @@index([cancellationPolicyId, isActive, deadlineUnit, windowFromValue, windowToValue])
  @@map("hotel_contract_cancellation_rules")
}

model HotelContractCancellationAuditLog {
  id                   String                           @id @default(uuid()) @db.Uuid
  hotelContractId      String                           @db.Uuid
  cancellationPolicyId String?                          @db.Uuid
  cancellationRuleId   String?                          @db.Uuid
  action               String
  oldValue             String?
  newValue             String?
  note                 String?
  actorUserId          String                           @db.Uuid
  actor                String?
  createdAt            DateTime                         @default(now())
  hotelContract        HotelContract                    @relation(fields: [hotelContractId], references: [id], onDelete: Cascade)
  cancellationPolicy   HotelContractCancellationPolicy? @relation(fields: [cancellationPolicyId], references: [id], onDelete: Cascade)
  cancellationRule     HotelContractCancellationRule?   @relation(fields: [cancellationRuleId], references: [id], onDelete: Cascade)

  @@index([hotelContractId, createdAt])
  @@index([cancellationPolicyId, createdAt])
  @@index([cancellationRuleId, createdAt])
  @@index([actorUserId, createdAt])
